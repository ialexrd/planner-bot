# Скопируйте в .env и заполните. Этот файл никому не присылайте.

# Новый токен от @BotFather. НЕ токен первого бота (@chistka74_zayavki_bot)!
TELEGRAM_TOKEN=

# Ваш личный Telegram ID (узнать: написать боту /id).
OWNER_ID=1297098835

# Короткий опрос Telegram: на этом сервере обязательно 2, иначе сообщения теряются в туннеле.
TELEGRAM_POLL_TIMEOUT=2

# Часовой пояс расписания (Калининград). Для Челябинска было бы Asia/Yekaterinburg.
TZ_NAME=Europe/Kaliningrad
MORNING_TIME=09:30
EVENING_TIME=21:00
# Отдельное напоминание про шею. Оставьте пустым, чтобы отключить.
NECK_TIME=22:30

# DeepSeek. Лучше отдельный ключ (platform.deepseek.com → API keys), чтобы видеть расходы каждого бота.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Папка с историей разговора и списком уже присланных идей.
DATA_DIR=data

# Яндекс Cloud: голосовые и скриншоты. Те же ключи, что у первого бота (/opt/assistant-bot/.env).
YANDEX_API_KEY=
YANDEX_FOLDER_ID=

# Планер (ialexrd.github.io/planer) через Firestore. Тот же ключ, что у первого бота. Пусто = без планера.
GOOGLE_APPLICATION_CREDENTIALS=/opt/assistant-bot/firebase-key.json
